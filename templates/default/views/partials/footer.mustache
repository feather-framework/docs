<footer id="site-footer">
    <div class="grid grid-421">

        <div>
            <h4>Menu</h4>
            <ul>
                {{#site.navigation}}
                <li><a href="{{url}}"{{#target}} target="{{.}}"{{/target}}>{{label}}</a></li>
                {{/site.navigation}}
            </ul>
        </div>
        
        <div>
            <h4>Links</h4>
            <ul>
                <li><a href="https://binarybirds.com/" target="_blank">Binary Birds</a></li>
                <li><a href="https://swiftonserver.com/" target="_blank">swiftonserver.com</a></li>
                <li><a href="https://theswiftdev.com/" target="_blank">theswiftdev.com</a></li>
                <li><a href="{{baseUrl}}/sitemap.xml" target="_blank">Sitemap</a></li>
            </ul>
        </div>
        
        
        <div>
            <picture>
                <img
                    id="logo-image"
                    src="{{baseUrl}}/images/logos/logo.png"
                    alt="Logo of {{site.name}}"
                    title="{{site.name}}"
                >
            </picture>
        </div>
        
        <div>
            <h4>Feather Framework</h4>
            <p><small>Backend components for server-side Swift.</small></p>
            <small><br>
                Binary Birds Kft.<br>
                &copy; 2022 - 2026<br>
                <a href="https://github.com/feather-framework" target="_blank">Open source on GitHub</a></small>
        </div>
    </div>
</footer>
